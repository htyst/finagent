FROM python:3.13-slim
WORKDIR /app
COPY backend/requirements.lock /app/backend/requirements.lock
RUN pip install --no-cache-dir -r /app/backend/requirements.lock
COPY backend /app/backend
COPY scripts/container-start.py scripts/local-auth.py /app/scripts/
RUN mkdir -p /app/var && chown 10001:10001 /app/var
ENV PYTHONPATH=/app/backend PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FINAGENT_MODE=mock
USER 10001:10001
CMD ["python", "scripts/container-start.py"]
