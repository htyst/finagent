# Copy to .env for local live-model experiments. Never commit a real key.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
FINAGENT_MODE=mock
# Per Live message, including model repairs; hard caps enforced server-side.
DIALOGUE_MAX_MODEL_CALLS=4
DIALOGUE_MAX_TOOLS=6
DIALOGUE_TIMEOUT_SECONDS=55
# FINAGENT_DB_PATH=var/finagent.sqlite3
