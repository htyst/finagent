# Copy to .env for local live-model experiments. Never commit a real key.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
FINAGENT_MODE=mock
# Dynamic tool loop: per-message safety limits, including repairs.
FINAGENT_AGENT_ENGINE=dynamic
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SECONDS=100
# Compatibility engine limits; these do not set the dynamic loop budget.
DIALOGUE_MAX_MODEL_CALLS=4
DIALOGUE_MAX_TOOLS=6
DIALOGUE_TIMEOUT_SECONDS=55
# FINAGENT_DB_PATH=var/finagent.sqlite3
