# Dataset hashes include the original UTF-8 BOM and CRLF bytes.
# Keep them identical with Git core.autocrlf=true on Windows.
datasets/** -text
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary

# Windows PowerShell 5.1 scripts retain UTF-8 BOM and Windows newlines.
*.ps1 text eol=crlf

*.exe binary
